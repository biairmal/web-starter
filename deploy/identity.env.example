# go-identity in deploy/compose.yaml. Copy to deploy/identity.env and fill in.
# The full list, with what each key does, is go-identity's .env.example; these
# are the ones this stack needs. DB_HOST and SIGNING_KEYS_DIR are set by the
# Compose file.

APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# Must match IDENTITY_DB_PASSWORD given to the postgres service.
DB_PASSWORD=identity
DB_SSLMODE=disable

AUTH_ENABLED=true
AUTH_JWKS_URL=http://identity:8080/.well-known/jwks.json

# Field encryption for stored emails: two distinct `openssl rand -base64 32`.
EMAIL_ENCRYPTION_KEY=
EMAIL_BLIND_INDEX_KEY=

# The two origins Caddy serves. FRONTEND_URL is web-starter's APP_URL; mail
# links and the Google redirect go there.
IDENTITY_PUBLIC_URL=https://id.localhost
FRONTEND_URL=https://app.localhost
# The browser never calls identity with fetch, so CORS stays empty.
CORS_ORIGINS=

# Behind Caddy.
TRUST_PROXY=true

# The worker refuses production without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=

AUTH_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REGISTRATION_ENABLED=true
TENANCY_MODE=single

# First start only: the one super admin, who must change the password at the
# first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Set when more than one identity replica runs.
REDIS_ADDR=
