# Copy to .env.local for local development. Every variable is validated when the
# server starts (src/config/env-schema.ts); a bad value stops the server and names it.

# Public origin of this app. Identity must list it in modules.auth.frontend_urls.
APP_URL=http://localhost:3000

# Server-side calls to identity (cluster-internal in production).
IDENTITY_INTERNAL_URL=http://localhost:4010

# Browser redirect target for Google sign-in (identity's public origin).
IDENTITY_PUBLIC_URL=http://localhost:4010

# Cookie encryption keys: 32+ random bytes, base64. Comma-separated to rotate
# (the first key encrypts, every key decrypts). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Cookie name prefix. Change it per app when several apps share a domain.
SESSION_COOKIE_PREFIX=ws

# How many X-Forwarded-For hops to trust when forwarding the client IP.
TRUSTED_PROXY_HOPS=1

# Default UI language: en or id.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server log level: trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
