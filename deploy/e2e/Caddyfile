# Plain HTTP in front of the web replicas for the e2e stack. Browsers treat
# http://localhost as secure, so the __Host- cookies still work. Automatic
# HTTPS stays on only for the TLS site below; :80 is never redirected.
{
	auto_https disable_redirects
}

:80 {
	reverse_proxy {
		dynamic a web 3000 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
	}
}

# The same replicas over HTTPS and HTTP/2, as production serves them
# (deploy/Caddyfile), with Caddy's local CA. `pnpm lighthouse` measures here
# (FE-NFR-3, PRD 3). The app still sees its own origin, APP_URL.
https://localhost:3443 {
	tls internal
	reverse_proxy {
		dynamic a web 3000 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		header_up Host localhost:3000
	}
}
