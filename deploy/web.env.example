# web-starter in deploy/compose.yaml. Copy to deploy/web.env and fill in.
# Every variable is checked at start (src/config/env-schema.ts); the container
# exits and names the variable when one is wrong. See .env.example for each.

# The app's public origin. Identity's FRONTEND_URL must be the same value.
APP_URL=https://app.localhost

# Identity's public origin (the Google sign-in redirect). Same as identity's
# IDENTITY_PUBLIC_URL.
IDENTITY_PUBLIC_URL=https://id.localhost

# 32+ random bytes, base64: openssl rand -base64 32
# Rotate by putting a new key first: NEW,OLD. Remove OLD after 90 days.
SESSION_SECRET=

SESSION_COOKIE_PREFIX=ws
NEXT_PUBLIC_DEFAULT_LOCALE=en
LOG_LEVEL=info

# identity's modules.tenant.default_tenant_slug (multi mode only).
# DEFAULT_TENANT_SLUG=default

# Business modules (docs/adding-a-module.md), e.g. the notes example:
# NOTES_INTERNAL_URL=http://notes:8080
