# Only what `pnpm build` needs goes into the build context.
.git
.github
.claude
.next
node_modules
coverage
playwright-report
test-results
blob-report
tsconfig.tsbuildinfo
*.log

# Local secrets never enter the image; it is configured at runtime.
.env
.env.*
!.env.example

# Not needed to build the app.
deploy
docs
README.md
AGENTS.md
Dockerfile
.dockerignore
